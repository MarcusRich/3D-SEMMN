# Local environments (a symlinked .venv is a file, not a directory)
.venv
.venv/
venv/
.env

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# OS and editor files
.DS_Store
._*
.idea/
.vscode/
*.swp

# Training outputs: checkpoints and the history log are regenerated by train.py.
# The previously committed history.json was one incomplete epoch from before the
# connectivity fix (a handful of edges, validation accuracy 0) and is not a result.
*.pt
outputs/history.json
